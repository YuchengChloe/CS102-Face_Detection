<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartattendance.gui.controllers.MainViewController"
            stylesheets="@../css/Application.css">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="200" minWidth="200">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            
            <!-- App Title -->
            <Label text="Smart Attendance" 
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"
                   wrapText="true"/>
            
            <Button fx:id="studentsBtn" text="👥 Students" 
                    onAction="#handleStudents" 
                    maxWidth="Infinity"
                    minWidth="180"/>
            <Button fx:id="liveBtn" text="📹 Live Recognition" 
                    onAction="#handleLive"
                    maxWidth="Infinity"
                    minWidth="180"/>
        </VBox>
    </left>

    <!-- Dynamic content -->
    <center>
        <StackPane fx:id="contentPane" styleClass="card">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>