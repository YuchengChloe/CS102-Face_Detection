<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.smartattendance.gui.controllers.StudentEditDialogController"
    stylesheets="@../css/Application.css"
    prefWidth="500">
    <content>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <Label text="Edit Student Information" styleClass="subheader" />

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                </columnConstraints>

                <Label text="Student ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="idField" promptText="e.g., S001" editable="false"
                    GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="nameField" promptText="e.g., John Doe"
                    GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Class:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="classGroupField" promptText="Select Class" maxWidth="Infinity"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="emailField" promptText="student@example.com"
                    GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="phoneField" promptText="98123456"
                    GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>

            <Separator />

            <VBox spacing="5" style="-fx-background-color: #FEF3C7; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="⚠ Important Note" 
                       style="-fx-text-fill: #92400E; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <Label text="Face data can only be submitted during initial enrollment. To update face images, please delete and re-enroll the student." 
                       wrapText="true"
                       maxWidth="470"
                       style="-fx-text-fill: #78350F; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </content>
</DialogPane>