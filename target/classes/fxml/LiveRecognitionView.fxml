<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartattendance.gui.controllers.LiveRecognitionController"
      alignment="TOP_CENTER" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Live Face Recognition" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ImageView fx:id="videoFrameView" fitHeight="480" fitWidth="640" preserveRatio="true"/>

    <Label fx:id="statusLabel" text="Initializing webcam..."/>
</VBox>